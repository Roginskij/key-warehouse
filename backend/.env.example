ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://localhost:5432/key_warehouse
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# console = print e-mails to the server log; smtp = real sending.
# Local testing: Mailpit from docker compose catches all mail (UI http://localhost:8025):
#   EMAIL_BACKEND=smtp SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false
EMAIL_BACKEND=console
EMAIL_FROM=KeyVerhaus <no-reply@keyverhaus.com>
# Brevo (EU): https://app.brevo.com -> SMTP & API -> SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Brute-force protection. TRUST_PROXY_HEADERS=true only behind your own nginx/Caddy.
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
