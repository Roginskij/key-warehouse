{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "/Users/nikita/!PROJECTS/key-warehouse/backend",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "/Users/nikita/!PROJECTS/key-warehouse/frontend/apps/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "shop",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NUXT_API_BASE=http://localhost:8000",
        "NUXT_PUBLIC_APP_URL=http://localhost:5173",
        "pnpm",
        "--dir",
        "/Users/nikita/!PROJECTS/key-warehouse/frontend/apps/shop",
        "dev"
      ],
      "port": 3000
    }
  ]
}